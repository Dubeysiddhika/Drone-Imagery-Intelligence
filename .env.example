# Local development uses the project-root drone.db SQLite database by default.
APP_ENV=development
# Optional PostgreSQL/PostGIS URL; unset uses project-root SQLite.
# DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/drone_intelligence
TEST_POSTGIS_DATABASE_URL=
# Optional; relative paths resolve from the project root.
VISDRONE10_MODEL_PATH=backend/app/models/weights/visdrone10_yolo11n_best.pt
# Leave unset for local development; Vite proxies /api to FastAPI.
# For a separate deployed API host, set VITE_API_BASE_URL to its HTTPS origin.
# VITE_API_BASE_URL=https://api.example.com
# Required when APP_ENV=production. Use a unique random secret of at least 32 bytes.
JWT_SECRET_KEY=
# Optional SMTP configuration for password-reset email. Without these values,
# reset requests remain private but no email is delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
FRONTEND_BASE_URL=http://127.0.0.1:5173
