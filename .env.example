# Local development uses the project-root drone.db SQLite database by default.
APP_ENV=development
# Optional PostgreSQL/PostGIS URL; unset uses project-root SQLite.
# DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/drone_intelligence
TEST_POSTGIS_DATABASE_URL=
# Optional; relative paths resolve from the project root.
VISDRONE10_MODEL_PATH=backend/app/models/weights/visdrone10_yolo11n_best.pt
VITE_API_BASE_URL=http://127.0.0.1:8000