# Copy this file to .env in the repository root. Never commit your real .env.
APP_ENV=development

# Local development uses the project-root SQLite database by default.
# For shared/production data, configure a persistent PostgreSQL + PostGIS service.
# DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/drone_intelligence
TEST_POSTGIS_DATABASE_URL=

# Model checkpoints. Paths may be absolute or relative to the repository root.
# The ten-class checkpoint in the repository is the recommended first-run model.
VISDRONE10_MODEL_PATH=backend/app/models/weights/visdrone10_yolo11n_best.pt
# The two-class baseline checkpoint is not included in Git; supply it separately.
BASELINE_MODEL_PATH=runs/drone_person_vehicle/weights/best.pt

# Runtime storage paths; relative paths resolve from the repository root.
UPLOAD_DIR=backend/uploads
# Supply the separately obtained UAV-VisLoc source dataset to enable matching.
UAV_VISLOC_DATASET_DIR=UAV_VisLoc_dataset
# Optional paths for the separately generated satellite retrieval index.
UAV_VISLOC_PHASE3C_DIR=backend/training/uav_visloc/phase3_pretrained_setup/phase3c
UAV_VISLOC_PHASE3H_DIR=backend/training/uav_visloc/phase3_pretrained_setup/phase3h
# Optional consolidated metadata CSV if stored outside its default location.
# UAV_VISLOC_CONSOLIDATED_CSV=backend/training/uav_visloc/phase1_validation/outputs/consolidated_drone_metadata.csv

# The browser uses Vite's same-origin /api proxy in local development.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# For a separately hosted frontend/API, set the API origin at frontend build time.
# VITE_API_BASE_URL=https://api.example.com

# Explicit comma-separated browser origins for deployments using a separate frontend.
# Include the exact scheme, host and port. Do not use '*'; session cookies need credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5175,http://127.0.0.1:5175
FRONTEND_BASE_URL=http://localhost:5173

# Required in production. Generate a unique random secret of at least 32 characters.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Optional SMTP configuration for password-reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
